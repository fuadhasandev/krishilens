{
  "name": "krishilens-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "tsc && node scripts/copyAgentAssets.mjs",
    "start": "node dist/dev.js",
    "typecheck": "tsc --noEmit",
    "test": "IMAGE_STORAGE_PROVIDER=local tsx --test test/*.test.ts",
    "test:cloudinary": "tsx --test test/cloudinary.integration.test.ts",
    "test:e2e": "RUN_REAL_E2E_TESTS=1 tsx --test test/realE2e.integration.test.ts",
    "test:e2e:cleanup": "tsx scripts/cleanupE2eRun.ts"
  },
  "dependencies": {
    "@meta-sam/parser": "^0.1.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "openai": "^6.49.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
